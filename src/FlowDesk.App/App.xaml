<Application x:Class="FlowDesk.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources><ResourceDictionary>
<ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
<ResourceDictionary.ThemeDictionaries>
<ResourceDictionary x:Key="Light">
 <LinearGradientBrush x:Key="GlassCanvasBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F0F5FC" Offset="0"/><GradientStop Color="#E8EDF8" Offset="1"/></LinearGradientBrush>
 <AcrylicBrush x:Key="GlassFillBrush" TintColor="#F9FBFE" TintOpacity="0.66" TintLuminosityOpacity="0.85" FallbackColor="#F9FBFE"/>
 <SolidColorBrush x:Key="GlassTintBrush" Color="#99FFFFFF"/>
 <SolidColorBrush x:Key="GlassTextBrush" Color="#182133"/>
 <SolidColorBrush x:Key="GlassSecondaryTextBrush" Color="#536176"/>
 <SolidColorBrush x:Key="GlassAccentBrush" Color="#246BEE"/>
 <SolidColorBrush x:Key="GlassStrokeBrush" Color="#CAD5E8" Opacity="0.72"/>
 <SolidColorBrush x:Key="GlassSuccessBrush" Color="#137B61"/>
 <SolidColorBrush x:Key="GlassOnAccentBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
 <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
</ResourceDictionary>
<ResourceDictionary x:Key="Dark">
 <LinearGradientBrush x:Key="GlassCanvasBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#101620" Offset="0"/><GradientStop Color="#20283D" Offset="1"/></LinearGradientBrush>
 <AcrylicBrush x:Key="GlassFillBrush" TintColor="#232D40" TintOpacity="0.66" TintLuminosityOpacity="0.85" FallbackColor="#232D40"/>
 <SolidColorBrush x:Key="GlassTintBrush" Color="#55232D40"/>
 <SolidColorBrush x:Key="GlassTextBrush" Color="#F3F6FD"/>
 <SolidColorBrush x:Key="GlassSecondaryTextBrush" Color="#AFBCD2"/>
 <SolidColorBrush x:Key="GlassAccentBrush" Color="#79A9FF"/>
 <SolidColorBrush x:Key="GlassStrokeBrush" Color="#44536E" Opacity="0.72"/>
 <SolidColorBrush x:Key="GlassSuccessBrush" Color="#7DDDC0"/>
 <SolidColorBrush x:Key="GlassOnAccentBrush" Color="#101620"/>
 <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
 <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
</ResourceDictionary>
<ResourceDictionary x:Key="HighContrast">
 <SolidColorBrush x:Key="GlassCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
 <SolidColorBrush x:Key="GlassFillBrush" Color="{ThemeResource SystemColorWindowColor}"/>
 <SolidColorBrush x:Key="GlassTintBrush" Color="{ThemeResource SystemColorWindowColor}"/>
 <SolidColorBrush x:Key="GlassTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
 <SolidColorBrush x:Key="GlassSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
 <SolidColorBrush x:Key="GlassAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
 <SolidColorBrush x:Key="GlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
 <SolidColorBrush x:Key="GlassSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
 <SolidColorBrush x:Key="GlassOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
 <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}"/>
 <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource SystemColorWindowColor}"/>
</ResourceDictionary></ResourceDictionary.ThemeDictionaries>
<Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
 <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,10"/>
 <Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="14"/>
 <Setter Property="Foreground" Value="{ThemeResource GlassTextBrush}"/>
 <Setter Property="Background" Value="{ThemeResource GlassTintBrush}"/>
 <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/>
</Style>
<Style x:Key="GlassPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
 <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="44"/>
 <Setter Property="Background" Value="{ThemeResource GlassAccentBrush}"/><Setter Property="Foreground" Value="{ThemeResource GlassOnAccentBrush}"/>
</Style>
<Style x:Key="GlassStageActiveStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
 <Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="{ThemeResource GlassFillBrush}"/>
 <Setter Property="BorderBrush" Value="{ThemeResource GlassAccentBrush}"/><Setter Property="BorderThickness" Value="2"/>
</Style>
<Style TargetType="ListView">
 <Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="12"/>
 <Setter Property="Background" Value="{ThemeResource GlassFillBrush}"/>
 <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/>
</Style>
<Style TargetType="TextBox"><Setter Property="CornerRadius" Value="12"/><Setter Property="MinHeight" Value="44"/></Style>
<Style TargetType="ComboBox"><Setter Property="CornerRadius" Value="12"/><Setter Property="MinHeight" Value="44"/></Style>
</ResourceDictionary></Application.Resources></Application>
