{
  "action": {
    "default_title": "FlowWeb",
    "default_popup": "popup.html"
  },
  "key": "",
  "version": "0.6.0",
  "background": {
    "type": "module",
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120",
  "manifest_version": 3,
  "incognito": "not_allowed",
  "name": "FlowDesk FlowWeb",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "storage"
  ],
  "description": "Connect selected browser controls and tab workspaces to your local FlowDesk app."
}
